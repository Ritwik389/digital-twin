# Put actual credentials in Hugging Face Settings > Secrets, never in Git.
GOOGLE_API_KEY_1=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Leave blank to use the authenticated user's home database.
NEO4J_DATABASE=
MEMORY_UPDATE_TURNS=5
# Read token from an account granted access to kyutai/pocket-tts.
HF_TOKEN=
POCKET_TTS_LANGUAGE=english
POCKET_TTS_REFERENCE=jensen_ref.wav
# Set paths to a mounted persistent volume if available.
MEMORY_DB_PATH=./storage/memory.db
CHROMA_PATH=./storage/chroma_db
AUDIO_DIR=./audio_cache

# Source-only relationship extraction: six passages per batch, once per corpus fingerprint.
# The topic/co-mention map always covers the full corpus. Increase up to 60 for deeper extraction.
MAP_RELATION_BATCHES=8
